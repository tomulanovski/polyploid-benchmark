tree TREE1 = [&R] ((1[&height=0.0,height_95%_HPD={0.0,0.0}]:0.02,(2[&height=0.0]:0.01,3[&height=0.0]:0.01)[&posterior=0.91,height=0.01]:0.01)[&posterior=1.0]:0.01,(4[&height=0.0]:0.015,5[&height=0.0]:0.015)[&posterior=0.88]:0.015)[&posterior=1.0,height=0.03];
